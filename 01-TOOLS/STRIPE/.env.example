# STRIPE — operational credentials
# Generate at: https://dashboard.stripe.com/test/apikeys  (sandbox)
#
# Copy this file to `.env`, fill in real values, and `chmod 600 .env`.

# test = sandbox (rk_test_...). live only after an explicit decision (rk_live_...).
STRIPE_ENV=test
# Restricted key, tagged as agent, READ permissions only (see CREDENTIALS.md).
# Never an sk_... secret key: the scripts refuse it.
STRIPE_API_KEY=
